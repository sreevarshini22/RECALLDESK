# RECALLDESK Environment Configuration
PROJECT_NAME="RECALLDESK"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Configuration (Defaults to SQLite for local zero-config execution)
DATABASE_URL="sqlite:///./recalldesk.db"
# For PostgreSQL: postgresql://postgres:password@localhost:5432/recalldesk

# AI / LLM Configuration (Optional: runs in rich Demo Mode if keys are not provided)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# Memory Engine Settings
MEMORY_CONFIDENCE_THRESHOLD=0.45
MEMORY_MAX_RETRIEVAL_LIMIT=5
MEMORY_DECAY_HALF_LIFE_DAYS=30
RELEVANCE_THRESHOLD=0.40

# Server
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
